# ─────────────────────────────────────────────────────────────
# Variables PÚBLICAS del frontend (prefijo VITE_). Se incrustan en
# el bundle: NUNCA pongas aquí claves secretas.
# ─────────────────────────────────────────────────────────────

# Proveedor de IA: "demo" (por defecto) o "gemini" (etapa futura).
VITE_AI_PROVIDER=demo

# Endpoint del BACKEND propio que hablará con Gemini (etapa futura).
# El frontend nunca llama a Gemini directamente.
VITE_AI_ENDPOINT=/api/ai/interpret

# Almacenamiento: "local" (IndexedDB, por defecto) o "supabase" (etapa futura).
VITE_STORAGE_PROVIDER=local

# Supabase (etapa futura). La anon key es pública por diseño y está
# protegida por Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Cloud Messaging (etapa futura).
VITE_FCM_VAPID_KEY=

# ─────────────────────────────────────────────────────────────
# Variables PRIVADAS: solo en el backend / funciones serverless.
# Nunca con prefijo VITE_.
# ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
